      "variants": {
        "cellular_browse": {
          "description_zh": "把浏览从 Wi-Fi 改为蜂窝网络（更贴近外出日）。",
          "segment_overrides": { "1": { "radio_mode": "lte" } }
        },
        "poor_signal_standby": {
          "description_zh": "把待机段设置为信号差（对耐久度影响通常很大）。",
