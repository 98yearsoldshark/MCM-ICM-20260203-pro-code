      "variants": {
        "poor_signal_rest": {
          "description_zh": "休止段信号差（用于对比信号差导致的额外耗电与电压裕量缩小）。",
          "segment_overrides": { "1": { "signal_quality": "poor" } }
        },
        "cold_outdoor": {
          "description_zh": "低温户外（ambient=-5°C）：验证恢复效应在低温下的差异（回弹更慢/欠压更易触发）。",
          "overrides": { "ambient_temp_c": -5.0 }
