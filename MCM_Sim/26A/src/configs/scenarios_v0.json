          "brightness_nits": 0.0,
          "activity": "standby",
          "cpu_load": 0.02,
          "gpu_load": 0.0,
          "radio_mode": "wifi",
          "signal_quality": "good",
          "net_activity": "idle",
          "gps_on": 0,
          "background_level": "low"
        }
