    ,
    "S5_burst_recovery": {
      "title_zh": "高负载→休止：恢复效应演示",
      "description_zh": "用于验证“恢复效应”：先给一段高负载（屏幕+CPU/GPU），随后进入低负载休止（屏幕关闭、后台轻）。Model-1/2/3 应表现为端电压与极化电压 v1 逐渐回升/衰减，而 SOC_true 仍单调下降。",
      "repeat": true,
      "cycle_s": 2400,
      "schedule": [
        {
          "duration_s": 600,
          "screen_on": 1,
          "brightness_nits": 250.0,
          "activity": "gaming",
          "cpu_load": 0.85,
          "gpu_load": 0.90,
          "radio_mode": "wifi",
          "signal_quality": "good",
          "net_activity": "idle",
          "gps_on": 0,
          "background_level": "low"
        },
        {
