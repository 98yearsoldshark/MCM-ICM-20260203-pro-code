      ],
      "variants": {
        "online_game": {
          "description_zh": "在线联机（持续少量网络）。",
          "overrides": { "net_activity": "game" }
        },
        "high_brightness": {
          "description_zh": "户外高亮度（对比亮度的边际收益）。",
          "overrides": { "brightness_nits": 400.0 }
        },
        "cold_outdoor": {
          "description_zh": "低温户外（ambient=-5°C）：高电流放电导致端电压下沉更大，易提前关机。",
          "overrides": { "ambient_temp_c": -5.0 }
        },
        "hot_summer": {
          "description_zh": "炎热夏季（ambient=40°C）：高负载更易升温，节流机制（若启用）可能改变功耗与续航。",
          "overrides": { "ambient_temp_c": 40.0 }
        }
      }
    },
    "S4_mixed_day": {
      "title_zh": "混合使用（标准一天）",
      "description_zh": "标准 24h 混合日程：每天 1h 通话 + 1h Wi-Fi 浏览 + 1h 视频，其余时间待机；循环重复用于 TTE/耐久度对比。",
      "repeat": true,
      "cycle_s": 86400,
      "schedule": [
