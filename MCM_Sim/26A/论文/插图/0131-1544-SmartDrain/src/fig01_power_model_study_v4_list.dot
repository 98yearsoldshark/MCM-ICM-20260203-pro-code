digraph fig01_power_model_study_v4_list {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    fontname="PingFang SC",
    fontsize=12,
    nodesep=0.35,
    ranksep=0.60,
    splines=true,
    pad="0.18"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#334155",
    fontname="PingFang SC",
    fontsize=12,
    penwidth=1.2,
    margin="0.10,0.08"
  ];

  edge [
    color="#334155",
    penwidth=1.1,
    arrowsize=0.9,
    fontname="PingFang SC",
    fontsize=11
  ];

  // 版本 v4：用“列表卡片”表达功耗分解，学习版用中文说明。

  components [
    fillcolor="#F1F5F9",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="6" CELLPADDING="6">
        <TR>
          <TD COLSPAN="2" ALIGN="LEFT"><B>设备功耗分解（模块列表）</B></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#E2E8F0" ALIGN="CENTER">基础功耗<BR/><I>P</I><SUB>base</SUB></TD>
          <TD BGCOLOR="#DBEAFE" ALIGN="CENTER">屏幕<BR/><I>P</I><SUB>screen</SUB>(t)</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER">CPU<BR/><I>P</I><SUB>cpu</SUB>(t)</TD>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER">GPU<BR/><I>P</I><SUB>gpu</SUB>(t)</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER">通信<BR/><I>P</I><SUB>net</SUB>(t)</TD>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER">定位<BR/><I>P</I><SUB>gps</SUB>(t)</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER">后台<BR/><I>P</I><SUB>bg</SUB>(t)</TD>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER">交互<BR/><I>P</I><SUB>int</SUB>(t)</TD>
        </TR>
      </TABLE>
    >
  ];

  sum [
    shape=circle,
    style="filled",
    fillcolor="#FFFFFF",
    label=<&Sigma;>,
    color="#334155",
    fontname="PingFang SC",
    fontsize=14,
    penwidth=1.2,
    width=0.38,
    height=0.38,
    fixedsize=true
  ];

  p_device [fillcolor="#E0E7FF", label=< <B>设备总功耗</B><BR/><I>P</I><SUB>device</SUB>(t) >];

  components -> sum;
  sum -> p_device [label="等于" fontcolor="#64748B"];

  pmic [fillcolor="#FFFFFF", label=< <B>PMIC</B><BR/><FONT POINT-SIZE="10">电源管理/转换</FONT> >];

  eta [
    shape=note,
    style="filled",
    fillcolor="#FFFFFF",
    color="#475569",
    fontcolor="#0F172A",
    label=<
      <B>效率参数</B><BR/>
      <I>&eta;</I><SUB>PMIC</SUB> = <I>&eta;</I><SUB>0</SUB><BR/>
      常量，范围 (0,1]<BR/>
      先验建议 0.90–0.95（Q3 敏感性中扰动）
    >
  ];

  p_batt [fillcolor="#E0F2FE", label=< <B>电池端功率</B><BR/><I>P</I><SUB>batt</SUB>(t) >];

  p_device -> pmic [label="除以效率" fontcolor="#64748B"];
  eta -> pmic [style=dashed, arrowhead=none, color="#94A3B8"];
  pmic -> p_batt;

  legend [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#CBD5E1",
    fontname="PingFang SC",
    fontsize=11,
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD BGCOLOR="#F8FAFC"><B>学习提示（变量含义）</B></TD></TR>
        <TR><TD ALIGN="LEFT">
          <B>P_device(t)</B>：设备侧功耗（各模块之和）<BR ALIGN="LEFT"/>
          <B>P_batt(t)</B>：电池端取出的功率（含 PMIC 损耗）
        </TD></TR>
      </TABLE>
    >
  ];

  { rank=sink; legend; }
}

