digraph fig01_power_model_paper_v7_equation {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    fontname="Helvetica",
    fontsize=12,
    nodesep=0.20,
    ranksep=0.40,
    splines=true,
    pad="0.10"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#334155",
    fontname="Helvetica",
    fontsize=12,
    penwidth=1.1,
    margin="0.10,0.06"
  ];

  edge [
    color="#334155",
    penwidth=1.0,
    arrowsize=0.85,
    fontname="Helvetica",
    fontsize=11
  ];

  // 版本 v7：极简“公式流程”版（高度最短、连线最少，适合小尺寸插图）。

  eq_device [
    fillcolor="#F1F5F9",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="4">
        <TR><TD ALIGN="LEFT"><B>Device power</B></TD></TR>
        <TR><TD ALIGN="LEFT">
          <I>P</I><SUB>device</SUB>(t) = <I>P</I><SUB>base</SUB> + <I>P</I><SUB>screen</SUB>(t) + <I>P</I><SUB>cpu</SUB>(t) + <I>P</I><SUB>gpu</SUB>(t)<BR ALIGN="LEFT"/>
          + <I>P</I><SUB>net</SUB>(t) + <I>P</I><SUB>gps</SUB>(t) + <I>P</I><SUB>bg</SUB>(t) + <I>P</I><SUB>int</SUB>(t)
        </TD></TR>
      </TABLE>
    >
  ];

  eq_batt [
    fillcolor="#E0F2FE",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="4">
        <TR><TD ALIGN="LEFT"><B>Battery-side power</B></TD></TR>
        <TR><TD ALIGN="LEFT">
          <I>P</I><SUB>batt</SUB>(t) = <I>P</I><SUB>device</SUB>(t) / <I>&eta;</I><SUB>PMIC</SUB>
        </TD></TR>
      </TABLE>
    >
  ];

  eta [
    shape=note,
    style="filled",
    fillcolor="#FFFFFF",
    color="#475569",
    fontcolor="#0F172A",
    fontsize=11,
    label=< <I>&eta;</I><SUB>PMIC</SUB> = <I>&eta;</I><SUB>0</SUB> , 0&lt;<I>&eta;</I><SUB>0</SUB>&le;1 >
  ];

  eq_device -> eq_batt;
  eta -> eq_batt [style=dashed, arrowhead=none, color="#94A3B8", constraint=false];
}

