digraph fig01_power_model_paper_v20_tb_group_card {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    fontname="Helvetica",
    fontsize=12,
    nodesep=0.18,
    ranksep=0.20,
    splines=true,
    pad="0.06"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#334155",
    fontname="Helvetica",
    fontsize=12,
    penwidth=1.0,
    margin="0.05,0.03"
  ];

  edge [
    color="#334155",
    penwidth=1.0,
    arrowsize=0.85,
    fontname="Helvetica",
    fontsize=11
  ];

  // v20：把 8 项“分组写在卡片里”，减少卡片的列数，从而降低整体宽度；
  // 同时保持图的高度较短（TB + 两节点一行）。

  components [
    fillcolor="#F1F5F9",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3">
        <TR>
          <TD BGCOLOR="#E2E8F0" ALIGN="CENTER"><I>P</I><SUB>base</SUB></TD>
          <TD BGCOLOR="#DBEAFE" ALIGN="CENTER"><I>P</I><SUB>screen</SUB>(t)</TD>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER">
            <I>P</I><SUB>comp</SUB>(t)<BR/>
            <FONT POINT-SIZE="9">=<I>P</I><SUB>cpu</SUB>(t)+<I>P</I><SUB>gpu</SUB>(t)</FONT>
          </TD>
        </TR>
        <TR>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER">
            <I>P</I><SUB>radio</SUB>(t)<BR/>
            <FONT POINT-SIZE="9">=<I>P</I><SUB>net</SUB>(t)+<I>P</I><SUB>gps</SUB>(t)</FONT>
          </TD>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER">
            <I>P</I><SUB>user</SUB>(t)<BR/>
            <FONT POINT-SIZE="9">=<I>P</I><SUB>bg</SUB>(t)+<I>P</I><SUB>int</SUB>(t)</FONT>
          </TD>
          <TD BGCOLOR="#F1F5F9" ALIGN="CENTER">&nbsp;</TD>
        </TR>
      </TABLE>
    >
  ];

  p_device [fillcolor="#E0E7FF", label=< <I>P</I><SUB>device</SUB>(t) >];
  p_batt   [fillcolor="#E0F2FE", label=< <I>P</I><SUB>batt</SUB>(t) >];

  { rank=same; p_device; p_batt; }

  components -> p_device [label=< <FONT POINT-SIZE="10">&Sigma;</FONT> > fontcolor="#64748B"];
  p_device -> p_batt [
    label=<
      <FONT POINT-SIZE="11">/ <I>&eta;</I><SUB>PMIC</SUB></FONT>
      <FONT POINT-SIZE="9">&nbsp;(<I>&eta;</I><SUB>PMIC</SUB>=<I>&eta;</I><SUB>0</SUB>)</FONT>
    >
    fontcolor="#64748B"
  ];
}

