digraph fig01_power_model_study_v18_tb_grid3x3_row_pmic {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    fontname="PingFang SC",
    fontsize=12,
    nodesep=0.20,
    ranksep=0.22,
    splines=true,
    pad="0.08"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#334155",
    fontname="PingFang SC",
    fontsize=12,
    penwidth=1.05,
    margin="0.06,0.04"
  ];

  edge [
    color="#334155",
    penwidth=1.0,
    arrowsize=0.85,
    fontname="PingFang SC",
    fontsize=11
  ];

  // v18：学习版（3×3 组件网格 + 一行 PMIC 链），保留语义同时控制高度。

  components [
    fillcolor="#F1F5F9",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3">
        <TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="11"><B>功耗模块</B></FONT></TD></TR>
        <TR>
          <TD BGCOLOR="#E2E8F0" ALIGN="CENTER">基础<BR/><I>P</I><SUB>base</SUB></TD>
          <TD BGCOLOR="#DBEAFE" ALIGN="CENTER">屏幕<BR/><I>P</I><SUB>screen</SUB>(t)</TD>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER">CPU<BR/><I>P</I><SUB>cpu</SUB>(t)</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER">GPU<BR/><I>P</I><SUB>gpu</SUB>(t)</TD>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER">通信<BR/><I>P</I><SUB>net</SUB>(t)</TD>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER">定位<BR/><I>P</I><SUB>gps</SUB>(t)</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER">后台<BR/><I>P</I><SUB>bg</SUB>(t)</TD>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER">交互<BR/><I>P</I><SUB>int</SUB>(t)</TD>
          <TD BGCOLOR="#F1F5F9" ALIGN="CENTER">&nbsp;</TD>
        </TR>
      </TABLE>
    >
  ];

  p_device [fillcolor="#E0E7FF", label=< <B>设备总功耗</B><BR/><I>P</I><SUB>device</SUB>(t) >];

  pmic [
    fillcolor="#FFFFFF",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD><B>PMIC</B></TD></TR>
        <TR><TD><FONT POINT-SIZE="10">效率：<I>&eta;</I><SUB>PMIC</SUB>=<I>&eta;</I><SUB>0</SUB></FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="10">建议：0.90–0.95</FONT></TD></TR>
      </TABLE>
    >
  ];

  p_batt [fillcolor="#E0F2FE", label=< <B>电池端功率</B><BR/><I>P</I><SUB>batt</SUB>(t) >];

  { rank=same; p_device; pmic; p_batt; }

  components -> p_device [label=< <FONT POINT-SIZE="10">求和</FONT> > fontcolor="#64748B"];
  p_device -> pmic [label="除以效率" fontcolor="#64748B"];
  pmic -> p_batt;
}

