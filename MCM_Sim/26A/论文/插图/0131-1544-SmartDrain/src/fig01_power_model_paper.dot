digraph fig01_power_model_paper {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    fontname="Helvetica",
    fontsize=12,
    nodesep=0.35,
    ranksep=0.55,
    splines=true,
    pad="0.18"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#334155",
    fontname="Helvetica",
    fontsize=12,
    penwidth=1.2,
    margin="0.10,0.06"
  ];

  edge [
    color="#334155",
    penwidth=1.1,
    arrowsize=0.9,
    fontname="Helvetica",
    fontsize=11
  ];

  // -------- Device-side power decomposition --------
  subgraph cluster_components {
    label="Device power components";
    color="#CBD5E1";
    style="rounded,filled";
    fillcolor="#F1F5F9";
    fontcolor="#0F172A";

    p_base   [label=< <I>P</I><SUB>base</SUB> >,       fillcolor="#E2E8F0"];
    p_screen [label=< <I>P</I><SUB>screen</SUB>(t) >,  fillcolor="#DBEAFE"];
    p_cpu    [label=< <I>P</I><SUB>cpu</SUB>(t) >,     fillcolor="#DCFCE7"];
    p_gpu    [label=< <I>P</I><SUB>gpu</SUB>(t) >,     fillcolor="#DCFCE7"];
    p_net    [label=< <I>P</I><SUB>net</SUB>(t) >,     fillcolor="#FFE4E6"];
    p_gps    [label=< <I>P</I><SUB>gps</SUB>(t) >,     fillcolor="#FFE4E6"];
    p_bg     [label=< <I>P</I><SUB>bg</SUB>(t) >,      fillcolor="#FEF9C3"];
    p_int    [label=< <I>P</I><SUB>int</SUB>(t) >,     fillcolor="#FEF9C3"];
  }

  sum [
    shape=circle,
    style="filled",
    fillcolor="#FFFFFF",
    label=<&Sigma;>,
    color="#334155",
    fontname="Helvetica",
    fontsize=14,
    penwidth=1.2,
    width=0.38,
    height=0.38,
    fixedsize=true
  ];

  p_device [label=< <I>P</I><SUB>device</SUB>(t) >, fillcolor="#E0E7FF"];

  p_base   -> sum;
  p_screen -> sum;
  p_cpu    -> sum;
  p_gpu    -> sum;
  p_net    -> sum;
  p_gps    -> sum;
  p_bg     -> sum;
  p_int    -> sum;

  sum -> p_device [label="=" fontcolor="#64748B"];

  // -------- PMIC efficiency mapping --------
  pmic [
    label="PMIC",
    fillcolor="#FFFFFF"
  ];

  eta [
    shape=note,
    style="filled",
    fillcolor="#FFFFFF",
    color="#475569",
    fontcolor="#0F172A",
    label=< <I>&eta;</I><SUB>PMIC</SUB> = <I>&eta;</I><SUB>0</SUB> >
  ];

  p_batt [label=< <I>P</I><SUB>batt</SUB>(t) >, fillcolor="#E0F2FE"];

  p_device -> pmic [label=< <FONT POINT-SIZE="11">/ <I>&eta;</I><SUB>PMIC</SUB></FONT> > fontcolor="#64748B"];
  eta -> pmic [style=dashed, arrowhead=none, color="#94A3B8"];
  pmic -> p_batt;
}
