digraph fig01_power_model_study_v8_direct {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    fontname="PingFang SC",
    fontsize=12,
    nodesep=0.20,
    ranksep=0.38,
    splines=true,
    pad="0.10"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#334155",
    fontname="PingFang SC",
    fontsize=12,
    penwidth=1.1,
    margin="0.06,0.04"
  ];

  edge [
    color="#334155",
    penwidth=1.0,
    arrowsize=0.85,
    fontname="PingFang SC",
    fontsize=11
  ];

  // 版本 v8：学习版（去掉 PMIC 方框，用“效率映射”箭头表达，版面更窄）。

  components [
    fillcolor="#F1F5F9",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="4">
        <TR>
          <TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>设备功耗（模块列表）</B></FONT></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#E2E8F0" ALIGN="CENTER">基础功耗<BR/><I>P</I><SUB>base</SUB></TD>
          <TD BGCOLOR="#DBEAFE" ALIGN="CENTER">屏幕<BR/><I>P</I><SUB>screen</SUB>(t)</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER">CPU<BR/><I>P</I><SUB>cpu</SUB>(t)</TD>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER">GPU<BR/><I>P</I><SUB>gpu</SUB>(t)</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER">通信<BR/><I>P</I><SUB>net</SUB>(t)</TD>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER">定位<BR/><I>P</I><SUB>gps</SUB>(t)</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER">后台<BR/><I>P</I><SUB>bg</SUB>(t)</TD>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER">交互<BR/><I>P</I><SUB>int</SUB>(t)</TD>
        </TR>
      </TABLE>
    >
  ];

  sum [
    shape=circle,
    style="filled",
    fillcolor="#FFFFFF",
    label=<&Sigma;>,
    color="#334155",
    fontname="PingFang SC",
    fontsize=14,
    penwidth=1.1,
    width=0.36,
    height=0.36,
    fixedsize=true
  ];

  p_device [fillcolor="#E0E7FF", label=< <B>设备总功耗</B><BR/><I>P</I><SUB>device</SUB>(t) >];
  p_batt   [fillcolor="#E0F2FE", label=< <B>电池端功率</B><BR/><I>P</I><SUB>batt</SUB>(t) >];

  eta [
    shape=note,
    style="filled",
    fillcolor="#FFFFFF",
    color="#475569",
    fontcolor="#0F172A",
    fontsize=11,
    label=<
      <B>效率参数</B><BR/>
      <I>&eta;</I><SUB>PMIC</SUB>=<I>&eta;</I><SUB>0</SUB><BR/>
      建议 0.90–0.95
    >
  ];

  components -> sum;
  sum -> p_device [label="等于" fontcolor="#64748B"];
  p_device -> p_batt [label="除以效率" fontcolor="#64748B"];
  eta -> p_batt [style=dashed, arrowhead=none, color="#94A3B8", constraint=false];
}

