digraph fig01_power_model_study_v6_grouped {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    fontname="PingFang SC",
    fontsize=12,
    nodesep=0.22,
    ranksep=0.45,
    splines=true,
    pad="0.12"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#334155",
    fontname="PingFang SC",
    fontsize=12,
    penwidth=1.1,
    margin="0.10,0.06"
  ];

  edge [
    color="#334155",
    penwidth=1.0,
    arrowsize=0.85,
    fontname="PingFang SC",
    fontsize=11
  ];

  // 版本 v6：用“分组”降低图的高度与连线数量（学习版增加中文解释，且保证包含原式各项）。

  subgraph cluster_groups {
    label="设备功耗（分组表示，等价于展开求和）";
    color="#CBD5E1";
    style="rounded,filled";
    fillcolor="#F1F5F9";
    fontcolor="#0F172A";

    g_base   [fillcolor="#E2E8F0", label=< <B>基础功耗</B><BR/><I>P</I><SUB>base</SUB> >];
    g_screen [fillcolor="#DBEAFE", label=< <B>屏幕</B><BR/><I>P</I><SUB>screen</SUB>(t) >];

    g_comp [
      fillcolor="#DCFCE7",
      label=<
        <B>计算</B><BR/>
        <I>P</I><SUB>comp</SUB>(t)<BR/>
        <FONT POINT-SIZE="10">= <I>P</I><SUB>cpu</SUB>(t) + <I>P</I><SUB>gpu</SUB>(t)</FONT>
      >
    ];

    g_radio [
      fillcolor="#FFE4E6",
      label=<
        <B>通信/定位</B><BR/>
        <I>P</I><SUB>radio</SUB>(t)<BR/>
        <FONT POINT-SIZE="10">= <I>P</I><SUB>net</SUB>(t) + <I>P</I><SUB>gps</SUB>(t)</FONT>
      >
    ];

    g_user [
      fillcolor="#FEF9C3",
      label=<
        <B>后台/交互</B><BR/>
        <I>P</I><SUB>user</SUB>(t)<BR/>
        <FONT POINT-SIZE="10">= <I>P</I><SUB>bg</SUB>(t) + <I>P</I><SUB>int</SUB>(t)</FONT>
      >
    ];

    {rank=same; g_base; g_screen; g_comp;}
    {rank=same; g_radio; g_user;}

    g_base -> g_screen -> g_comp [style=invis];
    g_radio -> g_user [style=invis];
  }

  sum [
    shape=circle,
    style="filled",
    fillcolor="#FFFFFF",
    label=<&Sigma;>,
    color="#334155",
    fontname="PingFang SC",
    fontsize=14,
    penwidth=1.1,
    width=0.36,
    height=0.36,
    fixedsize=true
  ];

  p_device [fillcolor="#E0E7FF", label=< <B>设备总功耗</B><BR/><I>P</I><SUB>device</SUB>(t) >];

  g_base   -> sum;
  g_screen -> sum;
  g_comp   -> sum;
  g_radio  -> sum;
  g_user   -> sum;

  sum -> p_device [label="等于" fontcolor="#64748B"];

  pmic [fillcolor="#FFFFFF", label=< <B>PMIC</B><BR/><FONT POINT-SIZE="10">电源管理/转换</FONT> >];

  eta [
    shape=note,
    style="filled",
    fillcolor="#FFFFFF",
    color="#475569",
    fontcolor="#0F172A",
    fontsize=11,
    label=<
      <B>效率</B><BR/>
      <I>&eta;</I><SUB>PMIC</SUB>=<I>&eta;</I><SUB>0</SUB><BR/>
      建议 0.90–0.95
    >
  ];

  p_batt [fillcolor="#E0F2FE", label=< <B>电池端功率</B><BR/><I>P</I><SUB>batt</SUB>(t) >];

  p_device -> pmic [label="除以效率" fontcolor="#64748B"];
  eta -> pmic [style=dashed, arrowhead=none, color="#94A3B8", constraint=false];
  pmic -> p_batt;
}

