digraph fig01_power_model_paper_v15_tb_top_card_row_chain {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    fontname="Helvetica",
    fontsize=12,
    nodesep=0.20,
    ranksep=0.22,
    splines=true,
    pad="0.08"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#334155",
    fontname="Helvetica",
    fontsize=12,
    penwidth=1.05,
    margin="0.06,0.04"
  ];

  edge [
    color="#334155",
    penwidth=1.0,
    arrowsize=0.85,
    fontname="Helvetica",
    fontsize=11
  ];

  // v15：上方是 4×2 组件卡片（高度短），下方把 P_device → PMIC → P_batt 放在同一行（避免过高）。

  components [
    fillcolor="#F1F5F9",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="4">
        <TR><TD COLSPAN="4" ALIGN="LEFT"><B>Components</B></TD></TR>
        <TR>
          <TD BGCOLOR="#E2E8F0" ALIGN="CENTER"><I>P</I><SUB>base</SUB></TD>
          <TD BGCOLOR="#DBEAFE" ALIGN="CENTER"><I>P</I><SUB>screen</SUB>(t)</TD>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER"><I>P</I><SUB>cpu</SUB>(t)</TD>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER"><I>P</I><SUB>gpu</SUB>(t)</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER"><I>P</I><SUB>net</SUB>(t)</TD>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER"><I>P</I><SUB>gps</SUB>(t)</TD>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER"><I>P</I><SUB>bg</SUB>(t)</TD>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER"><I>P</I><SUB>int</SUB>(t)</TD>
        </TR>
      </TABLE>
    >
  ];

  p_device [fillcolor="#E0E7FF", label=< <I>P</I><SUB>device</SUB>(t) >];

  pmic [
    fillcolor="#FFFFFF",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD><B>PMIC</B></TD></TR>
        <TR><TD><FONT POINT-SIZE="10"><I>&eta;</I><SUB>PMIC</SUB>=<I>&eta;</I><SUB>0</SUB></FONT></TD></TR>
      </TABLE>
    >
  ];

  p_batt [fillcolor="#E0F2FE", label=< <I>P</I><SUB>batt</SUB>(t) >];

  { rank=same; p_device; pmic; p_batt; }

  components -> p_device [label=< <FONT POINT-SIZE="10">&Sigma; (sum)</FONT> > fontcolor="#64748B"];
  p_device -> pmic [label=< <FONT POINT-SIZE="11">/ <I>&eta;</I><SUB>PMIC</SUB></FONT> > fontcolor="#64748B"];
  pmic -> p_batt;
}

