digraph fig01_power_model_study_v24_tb_ultra_compact {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    fontname="PingFang SC",
    fontsize=12,
    nodesep=0.16,
    ranksep=0.18,
    splines=true,
    pad="0.04"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#334155",
    fontname="PingFang SC",
    fontsize=12,
    penwidth=0.95,
    margin="0.04,0.02"
  ];

  edge [
    color="#334155",
    penwidth=0.95,
    arrowsize=0.82,
    fontname="PingFang SC",
    fontsize=11
  ];

  // v24：学习版极限压缩（不主动缩小字体，主要减少留白）。

  components [
    fillcolor="#F1F5F9",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR>
          <TD BGCOLOR="#E2E8F0" ALIGN="CENTER">基础<BR/><I>P</I><SUB>base</SUB></TD>
          <TD BGCOLOR="#DBEAFE" ALIGN="CENTER">屏幕<BR/><I>P</I><SUB>screen</SUB></TD>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER">CPU<BR/><I>P</I><SUB>cpu</SUB></TD>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER">GPU<BR/><I>P</I><SUB>gpu</SUB></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER">通信<BR/><I>P</I><SUB>net</SUB></TD>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER">定位<BR/><I>P</I><SUB>gps</SUB></TD>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER">后台<BR/><I>P</I><SUB>bg</SUB></TD>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER">交互<BR/><I>P</I><SUB>int</SUB></TD>
        </TR>
      </TABLE>
    >
  ];

  p_device [fillcolor="#E0E7FF", label=< <B>设备总功耗</B><BR/><I>P</I><SUB>device</SUB> >];
  p_batt   [fillcolor="#E0F2FE", label=< <B>电池端功率</B><BR/><I>P</I><SUB>batt</SUB> >];

  { rank=same; p_device; p_batt; }

  components -> p_device [label=< <FONT POINT-SIZE="10">求和</FONT> > fontcolor="#64748B"];
  p_device -> p_batt [label=< <FONT POINT-SIZE="11">/ <I>&eta;</I><SUB>0</SUB></FONT> > fontcolor="#64748B"];
}

