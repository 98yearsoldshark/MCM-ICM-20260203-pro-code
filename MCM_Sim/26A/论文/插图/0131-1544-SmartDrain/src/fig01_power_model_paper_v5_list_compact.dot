digraph fig01_power_model_paper_v5_list_compact {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    fontname="Helvetica",
    fontsize=12,
    nodesep=0.20,
    ranksep=0.35,
    splines=true,
    pad="0.10"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#334155",
    fontname="Helvetica",
    fontsize=12,
    penwidth=1.1,
    margin="0.06,0.04"
  ];

  edge [
    color="#334155",
    penwidth=1.0,
    arrowsize=0.85,
    fontname="Helvetica",
    fontsize=11
  ];

  // 版本 v5：在 v4 的“列表卡片”基础上进一步压缩宽度/留白（更适合论文版面）。

  components [
    fillcolor="#F1F5F9",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="4">
        <TR>
          <TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Device power</B></FONT></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#E2E8F0" ALIGN="CENTER"><FONT POINT-SIZE="12"><I>P</I><SUB>base</SUB></FONT></TD>
          <TD BGCOLOR="#DBEAFE" ALIGN="CENTER"><FONT POINT-SIZE="12"><I>P</I><SUB>screen</SUB>(t)</FONT></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER"><FONT POINT-SIZE="12"><I>P</I><SUB>cpu</SUB>(t)</FONT></TD>
          <TD BGCOLOR="#DCFCE7" ALIGN="CENTER"><FONT POINT-SIZE="12"><I>P</I><SUB>gpu</SUB>(t)</FONT></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER"><FONT POINT-SIZE="12"><I>P</I><SUB>net</SUB>(t)</FONT></TD>
          <TD BGCOLOR="#FFE4E6" ALIGN="CENTER"><FONT POINT-SIZE="12"><I>P</I><SUB>gps</SUB>(t)</FONT></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER"><FONT POINT-SIZE="12"><I>P</I><SUB>bg</SUB>(t)</FONT></TD>
          <TD BGCOLOR="#FEF9C3" ALIGN="CENTER"><FONT POINT-SIZE="12"><I>P</I><SUB>int</SUB>(t)</FONT></TD>
        </TR>
      </TABLE>
    >
  ];

  sum [
    shape=circle,
    style="filled",
    fillcolor="#FFFFFF",
    label=<&Sigma;>,
    color="#334155",
    fontname="Helvetica",
    fontsize=14,
    penwidth=1.1,
    width=0.36,
    height=0.36,
    fixedsize=true
  ];

  p_device [label=< <I>P</I><SUB>device</SUB>(t) >, fillcolor="#E0E7FF"];

  components -> sum;
  sum -> p_device [label="=" fontcolor="#64748B"];

  pmic [label="PMIC", fillcolor="#FFFFFF"];

  // 把效率说明移到箭头上方（减少横向占用）。
  eta [
    shape=note,
    style="filled",
    fillcolor="#FFFFFF",
    color="#475569",
    fontcolor="#0F172A",
    fontsize=11,
    label=< <I>&eta;</I><SUB>PMIC</SUB> = <I>&eta;</I><SUB>0</SUB> >
  ];

  p_batt [label=< <I>P</I><SUB>batt</SUB>(t) >, fillcolor="#E0F2FE"];

  p_device -> pmic [label=< <FONT POINT-SIZE="11">/ <I>&eta;</I><SUB>PMIC</SUB></FONT> > fontcolor="#64748B"];
  eta -> pmic [style=dashed, arrowhead=none, color="#94A3B8", constraint=false];
  pmic -> p_batt;
}

